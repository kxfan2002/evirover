# Copy to rllm/.env and fill in. The trainer sources that file if it exists,
# with xtrace disabled while it does, so keys are not echoed into the log.
# Override the location with ENV_FILE=/path/to/.env.
#
# Anything set in the shell wins over this file only if you export it after
# the run script sources .env -- in practice, keep credentials here and put
# paths and knobs on the command line.
#
# No value below is optional unless marked so. The search, browse and
# image-search tools fail loudly when a credential is missing rather than
# returning nothing, because a run with a silently dead tool is not comparable
# to one where it worked.

# --- web search: text_search, text_search_image, image_search ---------------
SERPER_API_KEY=

# --- browse: page retrieval -------------------------------------------------
# Optional. Improves fetch success; browse falls back to a direct fetch.
JINA_API_KEY=
# Optional. Proxy for the Jina fetch only, e.g. http://host:port
JINA_HTTPS_PROXY=

# --- browse: per-page summarisation -----------------------------------------
# Any OpenAI-compatible endpoint.
SUMMARY_BASE_URL=
SUMMARY_MODEL=
SUMMARY_API_KEY=

# --- image_search: object storage -------------------------------------------
# Reverse image search needs a publicly reachable URL, so the crop is uploaded
# first. Required only if image_search is enabled.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=

# --- SAM3: the segmentation reward and the verify_mask tool -----------------
# Path to sam3.pt. Set VDR_SAM_PREINIT=0 to train without segmentation.
SAM3_CHECKPOINT=
# Only needed for a plain clone rather than a pip install of facebook/sam3.
SAM3_REPO=

# --- optional: text_search via perplexity instead of serper -----------------
# Used only with VDR_TEXT_SEARCH_BACKEND=perplexity.
PPLX_API_KEY=

# ---------------------------------------------------------------------------
# Non-secret knobs. These are the values the released run used; they can also
# be passed on the command line.
# ---------------------------------------------------------------------------
# SERPER_BUDGET_LIMIT=25
# VDR_TEXT_SEARCH_BACKEND=serper
# VDR_SAM_PREINIT=1
# VDR_SAM_GPU=7
# MM_REWARD_SEG_REQUIRE_POINTS=1
# RLLM_TOOLSET=all
# Persists the per-task EMA state. Without it a resumed run re-warms from zero
# and the first ~1/(1-decay) steps are not reproducible.
# VDR_ADV_TRACKER_PATH=
