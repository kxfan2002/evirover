# Eval outputs.
results/

# Downloaded by EviLens/scripts/download_images.py (918 MB, hosted separately).
# Anchored deliberately: a slash in the middle of a pattern makes it relative to
# this file's directory, so a bare `benchmark/images/` would NOT match here.
EviLens/benchmark/images/

# Model weights (e.g. SAM3's sam3.pt). Anchored: a bare `models/` would also
# match vendored source packages such as RL/rllm/verl/verl/models/.
/models/

__pycache__/
*.pyc

# Credentials. RL/.env.example is the template; the filled-in copy never ships.
.env
RL/rllm/.env
